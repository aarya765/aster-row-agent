# Optional. If unset, the agent runs fully offline using deterministic
# template responses (this is what the evaluation suite uses by default).
# Set this to get LLM-phrased, more paraphrase-robust customer responses.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-5 if unset.
ASTER_ROW_MODEL=claude-sonnet-4-5
